# ============================================
# Database — Neon PostgreSQL (application tables)
# ============================================
# All application tables (analyses, artifacts, workspaces, github_*, model_*,
# provider_connections, local_relay_jobs, users) live in Neon.
#
# DATABASE_URL is the POOLED connection string (host contains "-pooler").
# Application queries use it through lib/db/pool.ts.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Same pooled endpoint, kept under the name the Neon CLI provisioned.
DATABASE_URL_POOLED=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ============================================
# Supabase — no longer required
# ============================================
# Authentication, user records and sessions are all handled by Neon
# (public.users, public.github_identities). The application no longer reads any
# Supabase variable, so NEXT_PUBLIC_SUPABASE_* and SUPABASE_SERVICE_ROLE_KEY are
# not needed in a new deployment.
#
# Apply migrations 001-022 to the Neon database before deploying. Sign-in writes
# public.users / public.github_identities; migration 022 widens the
# identity_source and repository_source constraints for the OAuth flow.

# ============================================
# GitHub OAuth App (sign-in + repository access)
# ============================================
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
#
#   Homepage URL:              https://bug-wiser.vercel.app
#   Authorization callback URL: https://bug-wiser.vercel.app/api/auth/callback
#
# An OAuth App accepts exactly ONE callback URL, so a deployment that needs both
# production and local sign-in needs two OAuth Apps (one per origin). Locally,
# register http://localhost:3000/api/auth/callback in the development App.
#
# BugWiser requests the scopes `read:user` and `repo`. `repo` is what allows
# private repositories and the apply-patch write path; there are no per-repository
# permissions to configure, unlike a GitHub App.
#
# The OAuth App credentials are NOT the GitHub App credentials: the client id is
# 20 alphanumeric characters (a numeric value is rejected by
# getGitHubOAuthConfigProblem(), because that is an App id pasted by mistake).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Aliases, read only when the names above are empty. Existing deployments keep
# GITHUB_APP_CLIENT_ID / GITHUB_APP_CLIENT_SECRET so a switch to an OAuth App
# does not require renaming variables; new deployments should use the names
# above and leave these unset.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# Legacy fallbacks (github App credentials reused as an OAuth App):
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
#
# A GitHub App's private key, App id, and slug are NOT used anymore: repository
# access is read with each user's own OAuth token, so there is no installation
# token to mint. GITHUB_APP_PRIVATE_KEY*, GITHUB_APP_ID and GITHUB_APP_SLUG can
# be deleted from an existing deployment.

# Public origin used for OAuth redirects. Required in production
# (https://bug-wiser.vercel.app); defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional override for the redirect_uri; defaults to
# ${NEXT_PUBLIC_APP_URL}/api/auth/callback. GITHUB_APP_CALLBACK_URL is read as a
# fallback so an already-registered App callback keeps working.
GITHUB_CALLBACK_URL=

# ============================================
# BugWiser session encryption
# ============================================
# The session is a single sealed (AES-256-GCM) HttpOnly cookie. An HKDF key is
# derived from this secret, so it signs AND encrypts: the cookie never exposes a
# GitHub token in the browser, and rotating this value invalidates every session.
# Minimum 32 characters; server-only.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BUGWISER_SESSION_SECRET=

# ============================================
# Public repository reads (optional)
# ============================================
# Analyses imported from a public repository read GitHub anonymously. Set a
# deployment-owned token only to raise the API rate limit. It must be a
# read-only token (no repo write, no user authorization) and is NEVER sent to
# the browser. Without it, public import still works at GitHub's anonymous rate.
GITHUB_PUBLIC_READ_TOKEN=

# ============================================
# AI Provider Configuration
# ============================================
# Supply credentials for the providers you want to use.
# The app selects models automatically based on task type.
# Unconfigured providers are skipped.

# --- OpenCode Zen (primary free models) ---
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# --- OpenRouter (free model gateway) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Z.AI / GLM ---
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# --- DeepSeek (paid fallback) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Gemini (emergency fallback) ---
GEMINI_API_KEY=

# --- Chutes (testing provider) ---
CHUTES_API_KEY=
CHUTES_BASE_URL=https://llm.chutes.ai/v1

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# Provider credential encryption (Models page)
# ============================================
# Used to encrypt user-supplied provider API keys at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, a deterministic local fallback is used — always set this in production.
BUGWISER_ENCRYPTION_KEY=

# ============================================
# Testing (optional)
# ============================================
# Simulate a provider failure to test fallback chains.
# AI_TEST_FAIL_PROVIDER=gemini
