# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# GitHub OAuth (configured in Supabase Dashboard)
#
# The legacy Supabase GitHub sign-in stays available as a fallback during
# rollout, but BugWiser now authenticates through its own GitHub App. The
# GitHub OAuth credentials below live in the Supabase dashboard and are NOT
# read by the app.

# ============================================
# GitHub App (primary sign-in + repository access)
# ============================================
# Create the app at https://github.com/settings/apps and set:
#   User authorization callback URL:
#     https://bug-wiser.vercel.app/api/auth/callback
#   Setup URL (redirect on update):
#     https://bug-wiser.vercel.app/api/auth/github/setup
#   Permissions: Contents read/write, Issues read, Metadata read,
#                Pull requests read/write
#   Where can it be installed: any account, on selected repositories
# Never commit the private key. Prefer GITHUB_APP_PRIVATE_KEY_BASE64 on hosts
# that mangle multi-line values (Vercel).
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The App private key (NOT a certificate). Multiline values in .env files must
# be wrapped in double quotes; an unquoted PEM is cut to its first line and the
# App can never sign a JWT. Prefer the BASE64 form below (single line):
#   node -e "process.stdout.write(Buffer.from(require('fs').readFileSync('key.pem','utf8')).toString('base64'))"
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_BASE64=

# The App SLUG only — the last segment of https://github.com/apps/<slug>.
# Example: for https://github.com/settings/apps/bugwiser-devassistant
#          and  https://github.com/apps/bugwiser-devassistant
#          set exactly: GITHUB_APP_SLUG=bugwiser-devassistant
# A full URL, a path, or a query string is rejected (it would produce a 404
# install link). Alphanumeric characters and single hyphens only.
GITHUB_APP_SLUG=

# Public origin used for OAuth redirects and install links.
# Required in production (https://bug-wiser.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional override; defaults to ${NEXT_PUBLIC_APP_URL}/api/auth/callback
GITHUB_APP_CALLBACK_URL=

# ============================================
# BugWiser session signing
# ============================================
# HMAC-SHA256 key for the HttpOnly session cookie. Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BUGWISER_SESSION_SECRET=

# ============================================
# Public repository reads (optional)
# ============================================
# Analyses imported from a public repository read GitHub anonymously. Set a
# deployment-owned token only to raise the API rate limit. It must be a
# read-only token (no repo write, no user authorization) and is NEVER sent to
# the browser. Without it, public import still works at GitHub's anonymous rate.
GITHUB_PUBLIC_READ_TOKEN=

# ============================================
# AI Provider Configuration
# ============================================
# Supply credentials for the providers you want to use.
# The app selects models automatically based on task type.
# Unconfigured providers are skipped.

# --- OpenCode Zen (primary free models) ---
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# --- OpenRouter (free model gateway) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Z.AI / GLM ---
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# --- DeepSeek (paid fallback) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Gemini (emergency fallback) ---
GEMINI_API_KEY=

# --- Chutes (testing provider) ---
CHUTES_API_KEY=
CHUTES_BASE_URL=https://llm.chutes.ai/v1

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# Provider credential encryption (Models page)
# ============================================
# Used to encrypt user-supplied provider API keys at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, a deterministic local fallback is used — always set this in production.
BUGWISER_ENCRYPTION_KEY=

# ============================================
# Testing (optional)
# ============================================
# Simulate a provider failure to test fallback chains.
# AI_TEST_FAIL_PROVIDER=gemini
